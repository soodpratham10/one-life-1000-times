# ----- Course files: reference only, never published -----
reference/

# ----- Raw source files -----
# Never committed: StatCan files are re-downloaded by the pipeline scripts, and
# CIA files are the CIA's copyrighted material (download them from cia-ica.ca;
# see README). Only the folder placeholder is kept.
data/raw/*
!data/raw/.gitkeep

# ----- Cleaned data derived from CIA publications (rebuilt locally) -----
data/clean/cia_*

# ----- Built outputs (re-created by the pipeline) -----
data/clean/*.db
data/clean/*.sqlite

# ----- Python -----
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# ----- R -----
.Rhistory
.RData
.Rproj.user/

# ----- Excel lock files -----
~$*.xlsx

# ----- Website tooling -----
node_modules/
web/dist/

# ----- Editor settings (personal to each machine) -----
.vscode/

# ----- Scratch output saved in the project folder (e.g. python ... > summary.txt) -----
/*.txt

# ----- Mac and secrets -----
.DS_Store
.env
